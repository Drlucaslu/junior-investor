APP_ENV=production
APP_DEFAULT_LANGUAGE=en-US
APP_SECRET=                      # optional; auto-generated and stored locally if empty
DATABASE_URL=sqlite:////data/junior_investor.db   # or postgresql+psycopg://user:pass@host:5432/db

LLM_PROVIDER=olares-local        # olares-local | openai-compatible | mock
LLM_BASE_URL=https://<your-llm-entrance>.olares.com/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_NATIVE_TOOLS=true            # false -> JSON tool-planning fallback

MARKET_DATA_PROVIDER=yahoo       # yahoo | mock
FUNDAMENTALS_PROVIDER=yahoo      # yahoo | mock
SEARCH_PROVIDER=duckduckgo       # duckduckgo | tavily | brave | mock
SEARCH_API_KEY=
SEC_USER_AGENT="OlaresJuniorInvestor/1.0 (you@example.com)"

DEFAULT_STARTING_CASH=1000000
DEFAULT_CURRENCY=USD
SIMULATED_COMMISSION_BPS=0
SIMULATED_SLIPPAGE_BPS=0
ALLOW_FRACTIONAL_SHARES=false
